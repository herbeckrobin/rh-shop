{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "rh-shop/cart-state",
    "title": "Warenkorb-Zustand",
    "category": "rh-shop",
    "icon": "visibility",
    "description": "Zeigt seinen Inhalt nur bei leerem oder nur bei gefülltem Warenkorb. Damit baust du beide Zustände der Warenkorb-Seite frei im Editor.",
    "textdomain": "rh-shop",
    "attributes": {
        "state": { "type": "string", "default": "filled" }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": { "margin": true, "padding": true }
    },
    "editorScript": "rh-shop-blocks-editor",
    "style": "rh-shop",
    "viewScript": "rh-shop-view",
    "render": "file:./render.php"
}
